# Optional. With no key the app runs in rules-only mode and says so on screen.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Postgres connection string (Neon, Supabase...). Leave empty locally to use the embedded database.
# Required when deploying to Vercel or any serverless host.
DATABASE_URL=

# Signs the demo session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional overrides
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_MODEL=text-embedding-3-small
